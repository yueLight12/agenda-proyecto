# Backend
agenda-backend/venv/
agenda-backend/.venv/
agenda-backend/__pycache__/
agenda-backend/**/__pycache__/
agenda-backend/.env
agenda-backend/*.sqlite3
agenda-backend/credenciales_reseteo.txt

# Imágenes subidas por usuarios (capturas de pantalla en notas, ver
# app/services/almacenamiento.py) — contenido real, no va a git.
agenda-backend/uploads/

# Archivos de carga con datos personales reales (cumpleaños/eventos de
# empresa, ver cargar_eventos_empresa.py) — no se suben a git.
*.xlsx
*.csv

# Respaldos de base de datos (pg_dump) — contienen hashes de contraseña y
# datos personales reales de usuarios.
/backups/
/respaldos/
*.sql

# Llaves privadas y CSR generados para el certificado SAML (ver
# app/services/saml_sso.py) — el CSR en sí no es secreto, pero vive junto
# a la llave privada en la misma carpeta; más simple excluir todo.
/certificados_saml/

# Frontend
agenda-frontend/node_modules/
agenda-frontend/dist/
agenda-frontend/dist-local/
agenda-frontend/dist-pruebas/
agenda-frontend/.env
agenda-frontend/.env.local

# General
.DS_Store
*.log
/.env
