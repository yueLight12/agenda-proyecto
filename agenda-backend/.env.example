# Copia este archivo a "agenda-backend/.env" (sin versionar) y llena tus
# propias credenciales. NUNCA subas el .env real a git.
#
# DATABASE_URL, SECRET_KEY y WHISPER_URL NO van aquí — se inyectan directo
# desde docker-compose.nueva.yml para el entorno local con Docker.

# Proveedor del asistente de voz / chatbot: "claude", "gemini" u "ollama".
# Para desarrollo local, usa tu propia API key de prueba (nunca la de
# producción). Si la dejas vacía, el asistente/chatbot no funcionará pero el
# resto del sistema sí.
ASISTENTE_LLM_PROVEEDOR=claude

GEMINI_API_KEY=
GEMINI_MODELO=gemini-flash-latest

CLAUDE_API_KEY=
CLAUDE_MODELO=claude-opus-5

# Correo de aviso "nunca has entrado al sistema" (2026-08-21) -- vía SMTP.
# En producción será Outlook/Office 365 (pendiente de permisos de TI, ver
# CLAUDE.md); mientras tanto el demo usa Gmail con una contraseña de
# aplicación (myaccount.google.com/apppasswords, requiere verificación en
# 2 pasos activada). Si se dejan vacíos, el envío se SIMULA (se registra
# en el log del backend) en vez de fallar.
SMTP_HOST=smtp.gmail.com
SMTP_PUERTO=587
SMTP_USUARIO=
SMTP_PASSWORD=
SMTP_NOMBRE_REMITENTE=Agenda Inteligente

# URL pública donde la persona entra a usar el sistema -- se incluye en el
# correo de aviso. Configúrala cuando se decida la URL definitiva.
URL_APP=

# Notificaciones push del navegador (Web Push, VAPID) para entregables
# urgentes (2026-08-23). Se generan UNA sola vez con:
#   python -c "from py_vapid import Vapid02; v = Vapid02(); v.generate_keys(); print(v.public_key.decode()); print(v.private_key.decode())"
# o con la CLI `vapid --gen` del paquete py-vapid. Si se dejan vacías, el
# envío se SIMULA (se registra en el log) igual que con SMTP.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT_EMAIL=
