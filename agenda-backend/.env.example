# Copia este archivo a .env y ajusta los valores

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agenda_inteligente

SECRET_KEY=cambia-esto-por-una-llave-segura-y-larga
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Umbral de días para considerar un entregable "próximo a vencer"
DIAS_ALERTA_ENTREGABLE=2

# Cada cuántas horas corre automáticamente el barrido de recordatorios
HORAS_ENTRE_BARRIDOS_RECORDATORIOS=6

# Chatbot de consulta: LLM local vía Ollama (corre en la máquina host, fuera de Docker)
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODELO=mistral:7b-instruct-q4_0

# Asistente de voz: transcripción con Whisper (corre DENTRO de Docker, ver docker-compose.yml)
WHISPER_URL=http://whisper:9000

# Motor de interpretación del asistente de voz: "ollama" (default, producción,
# datos reales) o "gemini" (SOLO pruebas de diseño con frases sintéticas,
# nunca con datos reales de clientes — sale a internet, a diferencia de Ollama).
ASISTENTE_LLM_PROVEEDOR=ollama
# API key gratuita: https://aistudio.google.com/apikey (solo hace falta si ASISTENTE_LLM_PROVEEDOR=gemini)
GEMINI_API_KEY=
GEMINI_MODELO=gemini-flash-latest
