# Copia este archivo a "agenda-backend/.env" (sin versionar) y llena tus
# propias credenciales. NUNCA subas el .env real a git.
#
# DATABASE_URL, SECRET_KEY y WHISPER_URL NO van aquí — se inyectan directo
# desde docker-compose.nueva.yml para el entorno local con Docker.

# Proveedor del asistente de voz / chatbot: "claude", "gemini" u "ollama".
# Para desarrollo local, usa tu propia API key de prueba (nunca la de
# producción). Si la dejas vacía, el asistente/chatbot no funcionará pero el
# resto del sistema sí.
ASISTENTE_LLM_PROVEEDOR=claude

GEMINI_API_KEY=
GEMINI_MODELO=gemini-flash-latest

CLAUDE_API_KEY=
CLAUDE_MODELO=claude-opus-5
