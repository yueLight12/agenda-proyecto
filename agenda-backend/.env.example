# Copia este archivo a "agenda-backend/.env" (sin versionar) y llena tus
# propias credenciales. NUNCA subas el .env real a git.
#
# DATABASE_URL, SECRET_KEY y WHISPER_URL NO van aquí — se inyectan directo
# desde docker-compose.nueva.yml para el entorno local con Docker.

# Proveedor del asistente de voz / chatbot: "claude", "gemini" u "ollama".
# Para desarrollo local, usa tu propia API key de prueba (nunca la de
# producción). Si la dejas vacía, el asistente/chatbot no funcionará pero el
# resto del sistema sí.
ASISTENTE_LLM_PROVEEDOR=claude

GEMINI_API_KEY=
GEMINI_MODELO=gemini-flash-latest

CLAUDE_API_KEY=
CLAUDE_MODELO=claude-opus-5

# Correo de aviso "nunca has entrado al sistema" (2026-08-21) -- vía SMTP.
# En producción será Outlook/Office 365 (pendiente de permisos de TI, ver
# CLAUDE.md); mientras tanto el demo usa Gmail con una contraseña de
# aplicación (myaccount.google.com/apppasswords, requiere verificación en
# 2 pasos activada). Si se dejan vacíos, el envío se SIMULA (se registra
# en el log del backend) en vez de fallar.
SMTP_HOST=smtp.gmail.com
SMTP_PUERTO=587
SMTP_USUARIO=
SMTP_PASSWORD=
SMTP_NOMBRE_REMITENTE=Agenda Inteligente

# INACTIVO desde 2026-08-24: se intentó Power Automate CLOUD (flujo con
# trigger HTTP + "Send an email (V2)" de Office 365 Outlook) para mandar
# desde el Outlook corporativo sin permisos de TI. El conector de Office
# 365 Outlook falló al conectar ("Failed to create OAuth connection:
# Connection not found") -- bloqueado por política de la organización,
# pendiente de que TI lo habilite. Ver el código comentado al final de
# app/services/email_cliente.py.
# POWER_AUTOMATE_WEBHOOK_URL_CORREO=

# INACTIVO desde 2026-08-24: se intentó Power Automate DESKTOP (Outlook de
# escritorio + bandeja de salida en la BD, app/routers/integraciones.py).
# Pausado por un problema de Outlook de escritorio en la laptop de Yue
# antes de terminar la prueba.
# INTEGRACION_CORREO_API_KEY=

# URL pública donde la persona entra a usar el sistema -- se incluye en el
# correo de aviso. Configúrala cuando se decida la URL definitiva.
URL_APP=

# Notificaciones push del navegador (Web Push, VAPID) para entregables
# urgentes (2026-08-23). Se generan UNA sola vez con:
#   python -c "from py_vapid import Vapid02; v = Vapid02(); v.generate_keys(); print(v.public_key.decode()); print(v.private_key.decode())"
# o con la CLI `vapid --gen` del paquete py-vapid. Si se dejan vacías, el
# envío se SIMULA (se registra en el log) igual que con SMTP.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT_EMAIL=

# Notificaciones fuera de la app para entregables urgentes, vía WhatsApp
# real (Ultramsg) -- Twilio (WhatsApp Sandbox, luego SMS) se descartó del
# todo el 2026-09-15, ver app/services/whatsapp.py. Ultramsg NO es la API
# oficial de WhatsApp Business (automatiza WhatsApp Web por QR desde un
# teléfono) -- aceptado explícitamente por Yue mientras se resuelve
# WhatsApp Business real. Si las credenciales quedan vacías, el envío se
# SIMULA (se registra en el log) igual que con SMTP/VAPID. Cada usuario
# necesita además su propio Usuario.telefono_whatsapp configurado (ver "Mi
# perfil").
ULTRAMSG_INSTANCE_ID=
ULTRAMSG_TOKEN=
# Segmento secreto del path del webhook entrante (Ultramsg no firma sus
# peticiones como Twilio) -- genera algo random y ponlo también al
# configurar el webhook_url en Ultramsg, ej. ".../webhooks/ultramsg/<esto>".
ULTRAMSG_WEBHOOK_SECRETO=

# Asignar tareas por WhatsApp (piloto acotado, 2026-08-27, ver
# app/routers/whatsapp_webhook.py) -- lista separada por comas de números
# en formato internacional autorizados a asignar tareas por este canal
# (hoy: solo Bernardo). Vacío = nadie puede usar el canal (falla cerrado).
WHATSAPP_ASIGNADOR_TAREAS_TELEFONOS=

# Login corporativo vía SAML 2.0 (2026-09-15, ver app/routers/saml_sso.py
# y app/services/saml_sso.py) -- segunda puerta de entrada opcional,
# NO reemplaza el login por email/contraseña. Si algo queda vacío, el
# feature se desactiva solo (503 en /saml/*) sin afectar el login normal.
SAML_SP_ENTITY_ID=
SAML_SP_ACS_URL=
# Rutas a archivo (PEM), NO el contenido inline.
SAML_SP_KEY_PATH=
SAML_SP_CERT_PATH=
# Datos del lado del IdP (Okta), entregados por quien administre el
# tenant al dar de alta esta app.
SAML_IDP_ENTITY_ID=
SAML_IDP_SSO_URL=
SAML_IDP_CERT_PATH=
